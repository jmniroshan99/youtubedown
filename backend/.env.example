SUPABASE_URL=https://dxtucfijilmytkwrzsox.supabase.co
SUPABASE_SECRET_KEY=SET_SERVER_SIDE_SECRET_HERE
REDIS_URL=redis://redis:6379/0
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MEDIA_PROXY=http://egress:8080
MAX_FILE_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=7200
MAX_ACTIVE_JOBS_PER_USER=2
DAILY_JOB_QUOTA=20
FILE_RETENTION_HOURS=1
SIGNED_URL_TTL_SECONDS=300
JOB_TIMEOUT_SECONDS=1800
# Native DASH/HLS fragments per download. Bounded 1-8; leave at 4 normally.
# This does not increase active-job quotas or guarantee the source's bandwidth.
MEDIA_FRAGMENT_CONCURRENCY=4
TEMP_ROOT=/tmp/videoflow

# Guest sessions still require verified Supabase tokens and private ownership.
GUEST_ACCESS_ENABLED=true
GUEST_MAX_FILE_SIZE_MB=100
GUEST_MAX_VIDEO_DURATION_SECONDS=7200
GUEST_MAX_ACTIVE_JOBS=1
GUEST_DAILY_JOB_QUOTA=5
GUEST_FILE_RETENTION_MINUTES=30
GUEST_ANALYSIS_PER_MINUTE=2
GUEST_ANALYSIS_PER_DAY=20
GUEST_NETWORK_ANALYSIS_PER_MINUTE=8
GUEST_NETWORK_ANALYSIS_PER_DAY=100
GUEST_NETWORK_CREATES_PER_MINUTE=6
GUEST_NETWORK_CREATES_PER_DAY=20
# Optional dedicated HMAC secret; otherwise the server Supabase secret is used.
GUEST_RATE_LIMIT_SECRET=
# Empty trusts no forwarded headers. Production Compose overrides with gateway /32.
TRUSTED_PROXY_CIDRS=

# Expiring Redis job metadata; no new permanent download history.
EPHEMERAL_JOB_TTL_SECONDS=86400
# Additional lease after signed URL expiry to protect active browser transfers.
DOWNLOAD_TRANSFER_GRACE_SECONDS=3600
